# Copy this file to .env.test and replace the placeholder values. Never commit .env.test.
# Server tests refuse to run unless the database name ends in _test.

# Test PostgreSQL connection used by server tests and the E2E API.
DATABASE_URL="postgresql://replace-user:replace-password@localhost:5436/cpe334_group_test?schema=public"

# Docker Compose settings for the test database (service "db-test", host port 5436).
POSTGRES_USER="replace-user"
POSTGRES_PASSWORD="replace-password"
POSTGRES_DB="cpe334_group_test"

PORT=4100
