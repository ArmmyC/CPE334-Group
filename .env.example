# Copy this file to .env and replace the placeholder values. Never commit .env.

# Development PostgreSQL connection used by Prisma and the API.
DATABASE_URL="postgresql://replace-user:replace-password@localhost:5435/cpe334_group?schema=public"

# Docker Compose settings for the development database (service "db", host port 5435).
# The user, password, and database name must match DATABASE_URL above.
POSTGRES_USER="replace-user"
POSTGRES_PASSWORD="replace-password"
POSTGRES_DB="cpe334_group"

# API port. The Vite dev server proxies /api to this port.
PORT=4100
