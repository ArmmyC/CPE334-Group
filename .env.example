# Copy this file to .env and replace the placeholder values. Never commit .env.

# Development PostgreSQL connection used by Prisma and the API.
DATABASE_URL="postgresql://replace-user:replace-password@localhost:5435/cpe334_group?schema=public"

# Docker Compose settings for the development database (service "db", host port 5435).
# The user, password, and database name must match DATABASE_URL above.
POSTGRES_USER="replace-user"
POSTGRES_PASSWORD="replace-password"
POSTGRES_DB="cpe334_group"

# API port. The Vite dev server proxies /api to this port.
PORT=4100

# Origins of the web app, comma-separated. The API refuses state-changing requests from any
# other origin, and refuses to start without this value outside production (SDS 7.4).
APP_ORIGIN="http://localhost:5190,http://127.0.0.1:5190"

# Optional. Folder with the built client (client/dist). Production serves ../../client/dist
# next to server/dist by default; set this only when the files live somewhere else.
# CLIENT_DIR="/app/client/dist"

# Password for every seeded account (npm run db:seed). At least 12 characters. Never commit the real value.
SEED_USER_PASSWORD="replace-with-a-seed-password"

# Optional smoke-test borrower for the Lab 5 deploy check. Leave unset locally.
# SMOKE_EMAIL="smoke@example.com"
# SMOKE_PASSWORD="replace-with-a-smoke-password"
