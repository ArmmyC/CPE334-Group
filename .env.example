# Copy this file to .env and replace the placeholder values. Never commit .env.

# Local PostgreSQL connection used by Prisma.
DATABASE_URL="postgresql://replace-user:replace-password@localhost:5433/cpe334_group?schema=public"

# Docker Compose database settings.
POSTGRES_USER="replace-user"
POSTGRES_PASSWORD="replace-password"
POSTGRES_DB="cpe334_group"
